<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ixiaozhou</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,sans-serif}
body{
    min-height:100vh;
    background:#f5f7fa;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:20px;
}
.box{
    background:#fff;
    padding:48px 40px;
    border-radius:16px;
    box-shadow:0 4px 20px rgba(0,0,0,0.08);
    text-align:center;
    width:100%;
    max-width:420px;
}
h1{
    font-size:28px;
    color:#222;
    margin-bottom:8px;
}
.desc{
    color:#666;
    margin-bottom:36px;
}
.btn-wrap{
    display:flex;
    flex-direction:column;
    gap:16px;
}
a.btn{
    display:block;
    text-decoration:none;
    padding:16px;
    border-radius:12px;
    font-size:16px;
    font-weight:500;
    transition:0.2s;
}
.btn-encrypt{
    background:#eef2ff;
    color:#3b5bdb;
    border:1px solid #c9d6ff;
}
.btn-game{
    background:#111;
    color:#fff;
}
a.btn:hover{transform:translateY(-2px);}
.tip{
    font-size:13px;
    color:#888;
    margin-top:6px;
}
footer{
    margin-top:40px;
    color:#999;
    font-size:14px;
}
</style>
</head>
<body>
<div class="box">
    <h1>ixiaozhou</h1>
    <p class="desc">个人站点</p>
    <div class="btn-wrap">
        <a class="btn btn-encrypt" href="https://jiami.ixiaozhou.com">加密平台</a>
        <div class="tip">现在不稳定，没有客服接入</div>

        <a class="btn btn-game" href="https://game.ixiaozhou.com">游戏圈</a>
    </div>
</div>
<footer>© ixiaozhou.com</footer>
</body>
</html>
